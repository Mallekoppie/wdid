{
    // wdid development container.
    //
    // Provides the full toolchain needed to edit, build, test and run this
    // repository: Go, protoc + Go/Dart plugins, the Dart/Flutter SDK for the
    // web UI, Claude Code (CLI + VS Code extension), the GitHub CLI (for
    // issues and pull requests) and the usual shell tooling (make, curl, jq...).
    //
    // Engine: Podman on the host (rootless). The host's podman socket is
    // mounted in so `podman`/`docker` commands inside the container drive the
    // host engine. The wdid server itself runs inside the container; only
    // image builds are delegated to the host engine.
    "name": "wdid Dev",

    // Build from our own Dockerfile so the toolchain is pinned and reproducible.
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "GO_VERSION": "1.27",
            "FLUTTER_CHANNEL": "stable"
        }
    },

    // Claude Code CLI + VS Code extension, installed by the official feature.
    // It needs node/npm. The Go base image ships nvm but no installed Node
    // version, so install Node explicitly first: the Claude feature declares
    // an installsAfter dependency on it. (Without this, the feature's own
    // NodeSource fallback fails on Debian trixie because Debian's nodejs
    // package no longer pulls in npm.)
    "features": {
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},

        // GitHub CLI (`gh`), so issues and pull requests can be read and
        // updated against github.com/Mallekoppie/wdid. Pin the CLI version so
        // rebuilds are reproducible; bump it deliberately.
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "2.103.2"
        }
    },

    // The remote user created by the base image. Keep the workspace owned by it.
    "remoteUser": "vscode",
    "containerUser": "vscode",

    // --userns=keep-id makes the container's uid 1000 match the host uid 1000.
    // The host owns the bind-mounted workspace and the podman socket (both uid
    // 1000, socket mode 0660), so this is what lets the container read/write the
    // repo with the right ownership AND open the mounted podman socket.
    "runArgs": [
        "--userns=keep-id",
        "--security-opt=label=disable"
    ],

    // Mount the host podman socket so the container can talk to the host engine.
    // On Bazzite the rootless socket lives at /run/user/1000/podman/podman.sock.
    // The Claude Code config and the GitHub CLI config live in named volumes so
    // the logins/settings survive container rebuilds (CLAUDE_CONFIG_DIR below
    // points at the Claude one).
    "mounts": [
        "source=/run/user/1000/podman/podman.sock,target=/run/host-podman.sock,type=bind",
        "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
        "source=gh-config-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
    ],

    // Make the mounted socket discoverable by podman/docker clients in the
    // container. DOCKER_HOST is what the VS Code container tooling and any
    // `docker`-invoking script read.
    "containerEnv": {
        "DOCKER_HOST": "unix:///run/host-podman.sock",
        "CONTAINER_HOST": "unix:///run/host-podman.sock",
        "PODMAN_HOST": "unix:///run/host-podman.sock",
        "GOFLAGS": "-mod=mod",
        "PUB_CACHE": "/home/vscode/.pub-cache",
        // Keep Claude Code's ~/.claude.json inside the mounted config volume,
        // otherwise it lands in the ephemeral home directory and is lost on
        // rebuild (forcing the first-run setup again).
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        "PATH": "/usr/local/share/nvm/current/bin:/go/bin:/home/vscode/.local/bin:/home/vscode/.pub-cache/bin:/opt/flutter/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    },

    // The server serves native gRPC, gRPC-Web, and the Flutter web app on one
    // application origin. Keep this in step with the Makefile / config default.
    // 8080 is the config default (`go run`), 9300 is `make run`, 5173 is
    // `make serveweb` (hot reload) and 9201 is `make run-demo`.
    "forwardPorts": [8080, 9300, 5173, 9201],
    "portsAttributes": {
        "8080": { "label": "wdid app origin (config default)" },
        "9300": { "label": "wdid app origin (make run)" },
        "5173": { "label": "Flutter web hot reload (make serveweb)" },
        "9201": { "label": "Seeded demo (make run-demo)" }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "golang.go",
                "ms-vscode.makefile-tools",
                "Dart-Code.dart-code",
                "Dart-Code.flutter",
                "redhat.vscode-yaml",
                "zxh404.vscode-proto3",
                "timonwong.shellcheck"
            ],
            "settings": {
                "go.toolsManagement.autoUpdate": true,
                "go.useLanguageServer": true,
                "dart.flutterSdkPath": "/opt/flutter",
                "terminal.integrated.defaultProfile.linux": "bash",
                "files.trimTrailingWhitespace": true
            }
        }
    },

    "postCreateCommand": "bash .devcontainer/post-create.sh",

    // Host environment passed through to terminals, tasks and extensions in
    // the container. ${localEnv:NAME} copies NAME from the host that runs the
    // container; unset names resolve to an empty string. Add more here (then
    // rebuild) if you use another provider or a proxy.
    "remoteEnv": {
        "PUB_CACHE": "/home/vscode/.pub-cache",
        "PATH": "/usr/local/share/nvm/current/bin:/go/bin:/home/vscode/.local/bin:/home/vscode/.pub-cache/bin:/opt/flutter/bin:${containerEnv:PATH}",

        // Claude Code auth, provider routing and model selection.
        "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
        "ANTHROPIC_AUTH_TOKEN": "${localEnv:ANTHROPIC_AUTH_TOKEN}",
        "ANTHROPIC_BASE_URL": "${localEnv:ANTHROPIC_BASE_URL}",
        "ANTHROPIC_CUSTOM_HEADERS": "${localEnv:ANTHROPIC_CUSTOM_HEADERS}",
        "ANTHROPIC_MODEL": "${localEnv:ANTHROPIC_MODEL}",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "${localEnv:ANTHROPIC_DEFAULT_OPUS_MODEL}",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "${localEnv:ANTHROPIC_DEFAULT_SONNET_MODEL}",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "${localEnv:ANTHROPIC_DEFAULT_HAIKU_MODEL}",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "${localEnv:ANTHROPIC_DEFAULT_FABLE_MODEL}",
        "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",

        // GitHub CLI auth. Set exactly one on the host: GH_TOKEN is preferred
        // by `gh`, GITHUB_TOKEN is also read. Without one, run `gh auth login`
        // in the container (the credential persists in the gh-config volume).
        "GH_TOKEN": "${localEnv:GH_TOKEN}",
        "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",

        // Copilot custom-provider settings.
        "COPILOT_PROVIDER_TYPE": "${localEnv:COPILOT_PROVIDER_TYPE}",
        "COPILOT_PROVIDER_BASE_URL": "${localEnv:COPILOT_PROVIDER_BASE_URL}",
        "COPILOT_PROVIDER_API_KEY": "${localEnv:COPILOT_PROVIDER_API_KEY}",
        "COPILOT_MODEL": "${localEnv:COPILOT_MODEL}"
    }
}
